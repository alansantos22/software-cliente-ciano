# ========================================
# CIANO - Sistema de Cotas (Development)
# ========================================

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=alan222al
DB_DATABASE=ciano_cotas

# JWT
JWT_SECRET=dev-secret-key-change-in-production-abc123xyz
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Throttle (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug

# Admin Seed
ADMIN_EMAIL=maziero.consultor@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Marcos Maziero

# Email (SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=adm@gshark.com.br
MAIL_PASSWORD=
MAIL_FROM=Ciano Cotas <adm@gshark.com.br>

# Frontend URL (usado nos links de e-mail e no retorno do checkout)
FRONTEND_URL=http://localhost:5173

# InfinitePay (Checkout Integrado - compra de cotas)
# Sem token/JWT: a conta é identificada só pelo handle (InfiniteTag, SEM "$").
INFINITEPAY_HANDLE=marcos-paulo-92i
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_SANDBOX=true
# URL do NOSSO backend que a InfinitePay chamará ao aprovar o pagamento.
INFINITEPAY_WEBHOOK_URL=http://localhost:3000/api/payments/webhook/infinitepay
